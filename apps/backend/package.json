{
  "name": "backend",
  "version": "1.0.50",
  "scripts": {
    "test": "bun test",
    "dev": "bun run --watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "codegen": "openapi-typescript ../../contract/openapi.yaml -o src/api/schema.ts && bun scripts/openapi-to-typebox.ts ../../contract/openapi.yaml src/api/schemas.ts",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "format": "biome format --write"
  },
  "dependencies": {
    "elysia": "latest"
  },
  "devDependencies": {
    "bun-types": "latest",
    "openapi-typescript": "^7.13.0",
    "typescript": "~6.0.2"
  },
  "module": "src/index.js"
}
